# ─── Core ────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/medplus?schema=public"
NEXT_PUBLIC_SITE_URL="https://www.genezenz-pharmacy.in"

# ─── Auth (generate: openssl rand -base64 48) ────────
AUTH_SECRET=""
ADMIN_EMAIL="care@genezenz-pharmacy.in"
ADMIN_PASSWORD=""

# ─── Overrides (brand data lives in src/lib/config.ts) ───
NEXT_PUBLIC_WHATSAPP_NUMBER="918044560873"
NEXT_PUBLIC_BUSINESS_LAT="11.0405"
NEXT_PUBLIC_BUSINESS_LNG="76.9899"
NEXT_PUBLIC_INSTAGRAM_URL=""

# ─── Meta (Facebook/Instagram) Lead Ads ──────────────
# Get these from developers.facebook.com after Business Verification.
# Until approved, leave blank — the webhook stays dormant and the rest of
# the site works fine. Nothing breaks.
META_APP_SECRET=""
META_VERIFY_TOKEN=""          # any long random string YOU choose
META_PAGE_ACCESS_TOKEN=""     # long-lived Page token, needs leads_retrieval
META_GRAPH_VERSION="v21.0"

# ─── Analytics ───────────────────────────────────────
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""

# ─── Prescription file storage ───────────────────────
# Leave BLOB token empty for local disk (VPS / Render with a persistent disk).
# On Vercel you MUST set this — serverless filesystems are wiped on redeploy.
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR=""                 # defaults to ./private-uploads

# ─── openFDA (optional, raises the rate limit) ───────
OPENFDA_API_KEY=""

# ─── Prescription encryption (recommended in production) ─────
# Prescriptions are encrypted with AES-256-GCM before storage.
# Without this, the key is derived from AUTH_SECRET — which means rotating
# AUTH_SECRET would make existing prescriptions unreadable. Set this to
# decouple them.  Generate:  openssl rand -base64 32
FILE_ENCRYPTION_KEY=""

# ─── Regulatory identity (shown in footer + About) ──────────
NEXT_PUBLIC_GSTIN=""             # e.g. "GSTIN: 33ABCDE1234F1Z5"
NEXT_PUBLIC_DRUG_LICENCE=""      # e.g. "DL No. 20B/21B: TN/CBE/..."
NEXT_PUBLIC_PHARMACIST=""        # e.g. "Pharmacist: S. Kumar"
NEXT_PUBLIC_PHARMACIST_REG=""    # e.g. "TNPC Reg. 12345"
